{
  "name": "Loggerizer Dev Container",
  "build": {
    "dockerfile": "Dockerfile.dev",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/loggerizer",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/loggerizer,type=bind,consistency=cached",
  "remoteUser": "root",
  "postCreateCommand": "uv sync --dev",
  "postStartCommand": "uv sync --dev",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "streetsidesoftware.code-spell-checker",
        "mhutchie.git-graph"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/loggerizer/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "terminal.integrated.cwd": "/workspaces/loggerizer",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}